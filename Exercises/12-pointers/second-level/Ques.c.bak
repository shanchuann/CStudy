#include <stdio.h>

/* TODO: 实现 max_ptr，让 *out 指向 a 与 b 中较大的那个（相等时指向 a） */
void max_ptr(int **out, int *a, int *b) {
    (void)out;
    (void)a;
    (void)b;
}

int main(void) {
    int a = 0, b = 0;
    if (scanf("%d %d", &a, &b) != 2) {
        return 0;
    }
    int *result = NULL;
    max_ptr(&result, &a, &b);
    /* TODO: 通过 result 输出较大值 */
    (void)result;
    return 0;
}

// Done
