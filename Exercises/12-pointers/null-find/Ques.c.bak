#include <stdio.h>

/* TODO: 实现 find，找到返回元素地址，找不到返回 NULL */
int *find(int *values, int n, int target) {
    (void)values;
    (void)n;
    (void)target;
    return NULL;
}

int main(void) {
    int n = 0, target = 0;
    int values[100];
    if (scanf("%d %d", &n, &target) != 2) {
        return 0;
    }
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &values[i]) != 1) {
            return 0;
        }
    }
    int *hit = find(values, n, target);
    /* TODO: 判断 hit 是否为 NULL，输出 index=... 或 not found */
    (void)hit;
    return 0;
}

// Done
