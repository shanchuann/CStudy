#include <stdio.h>

int next_auto(void) {
    int value = 0;
    return value;
}

/* TODO: 用 static 局部变量实现 next_static，使它依次返回 1、2、3 */
int next_static(void) {
    int value = 0;
    return value;
}

int main(void) {
    int a1 = next_auto();
    int a2 = next_auto();
    int a3 = next_auto();
    int s1 = next_static();
    int s2 = next_static();
    int s3 = next_static();
    printf("auto=%d %d %d static=%d %d %d\n", a1, a2, a3, s1, s2, s3);
    return 0;
}

// Done
