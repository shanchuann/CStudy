#include <stdio.h>

struct Student {
    char name[32];
    double scores[3];
};

int main(void) {
    struct Student s;
    double average = 0.0;
    if (scanf("%31s %lf %lf %lf", s.name, &s.scores[0], &s.scores[1], &s.scores[2]) != 4) {
        return 0;
    }
    /* TODO: 用 s.scores 的三门成绩算出平均分，保留两位小数输出 */
    (void)average;
    return 0;
}

// Done
